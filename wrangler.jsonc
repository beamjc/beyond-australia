{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beyond-australia",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Staging copy for testing (LINE LIFF etc.): npm run deploy:staging
  // -> https://beyond-australia-staging.<account>.workers.dev. The live site is untouched.
  "env": {
    "staging": {
      "name": "beyond-australia-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      }
    }
  }
}
